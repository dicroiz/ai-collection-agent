# =============================================================
# AI Collection Agent — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# ─── DATABASE ─────────────────────────────────────────────────
# Local (docker-compose): postgresql://collector:password@localhost:5432/collection_agent
# Production (Abacus AI): provided automatically
DATABASE_URL=postgresql://collector:password@localhost:5432/collection_agent

# ─── META WHATSAPP CLOUD API ──────────────────────────────────
# Get from: https://developers.facebook.com → My Apps → WhatsApp → API Setup
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
# Choose any string — must match what you set in Meta webhook config
META_WHATSAPP_VERIFY_TOKEN=my_custom_verify_token_123

# ─── OPENAI ───────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── VAPI.AI (Voice Call Orchestration) ───────────────────────
# Get from: https://app.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_api_key_here
# Create an assistant in Vapi dashboard, copy its ID here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
# Your Twilio Brazilian +55 number, in E.164 format
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# ─── TWILIO (Brazilian Telephony — used by Vapi internally) ───
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ─── ELEVENLABS (PT-BR Voice Synthesis — used by Vapi) ────────
# Get from: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
